rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role == 'admin';
    }

    match /productos/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /ofertas/{offerId} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll([
          'productoId', 'nombreProducto', 'titulo', 'descripcion',
          'precioOriginal', 'precioOferta', 'imagen', 'activa', 'createdAt', 'updatedAt',
          'productoIds', 'productos'
        ])
        && request.resource.data.keys().hasOnly([
          'productoId', 'nombreProducto', 'titulo', 'descripcion',
          'precioOriginal', 'precioOferta', 'imagen', 'activa', 'createdAt', 'updatedAt',
          'productoIds', 'productos'
        ])
        && request.resource.data.productoId is string
        && request.resource.data.nombreProducto is string
        && request.resource.data.titulo is string
        && request.resource.data.descripcion is string
        && request.resource.data.precioOriginal is number
        && request.resource.data.precioOferta is number
        && request.resource.data.imagen is string
        && request.resource.data.activa is bool
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.productoIds is list
        && request.resource.data.productoIds.size() > 0
        && request.resource.data.productos is list
        && request.resource.data.productos.size() > 0
        && request.resource.data.productoIds.size() == request.resource.data.productos.size();
      allow update: if isAdmin()
        && request.resource.data.keys().hasAll([
          'productoId', 'nombreProducto', 'titulo', 'descripcion',
          'precioOriginal', 'precioOferta', 'imagen', 'activa', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'productoId', 'nombreProducto', 'titulo', 'descripcion',
          'precioOriginal', 'precioOferta', 'imagen', 'activa', 'createdAt', 'updatedAt',
          'productoIds', 'productos'
        ])
        && request.resource.data.productoId is string
        && request.resource.data.nombreProducto is string
        && request.resource.data.titulo is string
        && request.resource.data.descripcion is string
        && request.resource.data.precioOriginal is number
        && request.resource.data.precioOferta is number
        && request.resource.data.imagen is string
        && request.resource.data.activa is bool
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && (!request.resource.data.keys().hasAny(['productoIds', 'productos'])
          || (request.resource.data.keys().hasAll(['productoIds', 'productos'])
            && request.resource.data.productoIds is list
            && request.resource.data.productoIds.size() > 0
            && request.resource.data.productos is list
            && request.resource.data.productos.size() > 0
            && request.resource.data.productoIds.size() == request.resource.data.productos.size()));
      allow delete: if isAdmin();
    }

    match /usuarios/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasAll(['username', 'email', 'telefono', 'role'])
        && request.resource.data.keys().hasOnly(['username', 'email', 'telefono', 'role'])
        && request.resource.data.role == 'user'
        && request.resource.data.username is string
        && request.resource.data.email is string
        && request.resource.data.telefono is string;
      allow update: if isOwner(userId)
        && request.resource.data.role == resource.data.role
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['username', 'email', 'telefono'])
        && request.resource.data.username is string
        && request.resource.data.email is string
        && request.resource.data.telefono is string;
      allow list, delete: if false;

      match /carrito/{cartId} {
        allow read, write: if isOwner(userId);
      }

      match /direcciones/{addressId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /nombresUsuario/{username} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && username.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.keys().hasOnly(['uid', 'authEmail'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.authEmail == request.auth.token.email;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.authEmail == request.auth.token.email
        && request.resource.data.keys().hasOnly(['uid', 'authEmail']);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /pedido/{orderId} {
      allow create: if signedIn() && request.resource.data.usuarioId == request.auth.uid;
      allow read: if signedIn()
        && (resource.data.usuarioId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }
  }
}
